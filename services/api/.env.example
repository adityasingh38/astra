SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=ASTRA/0.3 (contact: you@example.com)
# For a hosted web app, add its exact HTTPS origin (comma-separate multiple origins).
# ASTRA_ALLOWED_ORIGINS=https://your-app.example.com
# Public Nominatim is for small, user-triggered search traffic only. Keep one API worker,
# respect its one-request-per-second limit, cache results, and switch GEOCODING_URL if traffic grows.
# GEOCODING_API_KEY is sent as a Bearer token when the provider requires it.
# ASTRA_ENV=production
# GEOCODING_API_KEY=
# SWEPH_EPHE_PATH=   # optional override; bundled files are SHA-256 verified
